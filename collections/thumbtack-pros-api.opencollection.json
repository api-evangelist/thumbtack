{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thumbtack Demand Authentication Pros API",
    "version": "4.0.0-draft"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pros",
        "type": "folder"
      },
      "items": [
