{
  "opencollection": "1.0.0",
  "info": {
    "name": "Thumbtack Demand Authentication Autocomplete API",
    "version": "4.0.0-draft"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Autocomplete",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve autocomplete results for a search query",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.thumbtack.com/v2/autocomplete",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Free-text search term to autocomplete."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve autocomplete results for a search query"
        }
      ]
    }
  ],
  "bundled": true
}